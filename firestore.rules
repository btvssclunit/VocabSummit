rules_version = "2";
service cloud.firestore {
  match /databases/{database}/documents {

    /* ==================== ACCESS MODEL (owner 2026-09-02) ==================
       Four tiers, decided by TWO fields on teachers/{uid}, not one role string:

         role     superadmin | hod | sh | teacher | viewer
         orgType  school | agency      <- decides how many schools you can see
         org      canonical "中文 English", byte-identical to student
                  profile.school

       | who                  | role       | orgType | sees | edits |
       |----------------------|------------|---------|------|-------|
       | system admin (owner) | superadmin | school  | all  | all   |
       | HOD/MTL, per school  | hod        | school  | own  | own   |
       | SH/CL, per school    | sh         | school  | own  | own   |
       | CL teacher           | teacher    | school  | own  | none  |
       | HQ / SCCL            | viewer     | agency  | all  | none  |

       hod and sh carry IDENTICAL rights (owner 2026-09-03: "HOD and SH has the
       same level of rights"). They are two values because this field is a job
       title, not a permission level: it is printed on the teacher-admin page,
       so it has to match the school's own roster. hod means HOD/MTL (Mother
       Tongue department head), sh means SH/CL (Chinese subject head); heads of
       other departments and level heads are not part of this model.

       Always test rights with isSchoolManager(), never myRole() == "hod".
       Once the two values get compared rule by rule, some rule will list only
       one of them, and that omission has no symptom -- an SH just silently
       cannot press a button. The literal "hod" belongs in exactly two places:
       isSchoolManager() below, and the grantable() whitelist.

       role and orgType are separate on purpose. Encoding "HQ sees everything"
       as an hq role would mean adding another role for the next agency (SCCL is
       already on the list), and every added role means re-reading every rule
       below. orgType answers one question -- is this person tied to a single
       school -- and that is the only input to how many schools they see.

       Defaults must reproduce pre-2026-09-02 behaviour exactly, or this release
       locks every existing teacher out: role defaults to "teacher", orgType to
       "school", org falls back to the old school field. An existing
       {school, role:"hod", active:true} doc therefore still means "HOD of Bukit
       View" and needs no migration.
       The owner's own doc must be raised to superadmin by hand (console, or
       local-admin/migrate_teacher_roles.py). Until then it is just a school
       HOD: no cross-school visibility, no cross-school approvals.

       Every write rule must call canEdit(). Do not rely on "a viewer is not an
       hod, so it cannot write" -- that is an absent allow, not a deny, and the
       next write rule added here would hand HQ write access with no symptom.
       ==================================================================== */

    function staff() {
      return get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data;
    }
    function isStaff() {
      return request.auth != null
        && exists(/databases/$(database)/documents/teachers/$(request.auth.uid))
        && staff().active == true;
    }
    function myRole()    { return staff().get("role", "teacher"); }
    function myOrgType() { return staff().get("orgType", "school"); }
    function myOrg()     { return staff().get("org", staff().get("school", "")); }

    function isSuper()  { return isStaff() && myRole() == "superadmin"; }
    // agency (HQ / SCCL): sees everything, writes nothing.
    function isAgency() { return isStaff() && myOrgType() == "agency"; }
    // tied to one school (superadmin included: she is also a Bukit View HOD).
    function isSchoolStaff() { return isStaff() && myOrgType() == "school"; }
    /* school management = HOD or SH, identical rights. This is the ONLY place
       in the file that lists the two values together: to add a third management
       title, change this line and nothing else. */
    function isSchoolManager() { return isSchoolStaff() && myRole() in ["hod", "sh"]; }
    // global visibility = system admin or agency. READ ONLY.
    function seesAll()  { return isSuper() || isAgency(); }
    // the single write gate. agency is never inside it, whatever its role says.
    function canEdit()  { return isSuper() || isSchoolManager(); }

    /* Which school a student doc belongs to. Must go through get(key, default):
       reading straight through on a doc with no profile, or a profile with no
       school (new sign-ups, students who only reached 启航码头 / the dock),
       fails evaluation of the whole rule -- and one failed doc in a list means
       the ENTIRE query is denied, so one empty student doc would blank the
       teacher's class view. */
    function docSchool() {
      return resource.data.get("profile", {}).get("school", "");
    }
    function newDocSchool() {
      return request.resource.data.get("profile", {}).get("school", "");
    }
    // org on teachers/{uid} and teacherRequests/{uid} (old docs fall back to school).
    function rowOrg()    { return resource.data.get("org", resource.data.get("school", "")); }
    function newRowOrg() { return request.resource.data.get("org", request.resource.data.get("school", "")); }

    // student progress + profile (one doc per anonymous uid)
    match /users/{uid} {
      /* This rule covers get AND list, and list is what the whole access model
         rests on. Firestore evaluates per document: an HOD reading the
         collection succeeds only if EVERY returned doc passes -- which is why
         the client's .where("profile.school","==",myOrg) is mandatory, not
         merely polite. Without it the whole query is denied; it does not
         quietly return extra rows.
         Students pick their own school from a dropdown, so a student who chose
         "其他" (Other) or has not filled it in yet is invisible to every HOD and
         visible only to superadmin and agency. That is correct -- they are on no
         school's roster. The teacher dashboard lists them under 未分配
         (unassigned). */
      allow read:  if (request.auth != null && request.auth.uid == uid)
                   || seesAll()
                   || (isSchoolStaff() && docSchool() == myOrg());
      allow write: if request.auth != null && request.auth.uid == uid;
      /* Management may correct a wrongly-entered profile (nickname / school /
         class / role) from the teacher dashboard. Scoped to the top-level
         "profile" field only, so progress/pts/badges stay student-owned even
         while a typo'd school or class is being fixed.
         BOTH the old and the new school must match. Checking only resource (the
         pre-edit doc) would let an HOD move a student to another school -- and
         lose sight of them the moment it succeeds, with no way back. Checking
         only request would let them pull another school's student in.
         superadmin is exempt from both, because only she can do a genuine
         transfer. */
      allow update: if canEdit()
                    && (isSuper() || (docSchool() == myOrg() && newDocSchool() == myOrg()))
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["profile", "updatedAt"]);
    }

    /* leaderboard scores (one doc per anonymous uid). Any signed-in user reads
       (needed for the in-app board); each student writes only their own doc.
       Cross-school reads are deliberate: the board has a 校内 (own-school) tab
       and a 跨校 (cross-school) tab (cs.js renderLeaderboard, xh.js
       renderBoards), and the second one by definition reads other schools'
       rows. A row holds a nickname (pseudonym), a school and three numbers --
       no PII. The own-school tab filters CLIENT-SIDE on the student's own
       profile.school: it is a display option, not an access gate.

       scoreSane is sanity ceilings only (review 2026-09-04): the largest stream
       has 1,432 words, so alt > 2000 is a devtools edit rather than a student.
       Not anti-cheat, just bounds. pts.{quarter} keys are dynamic (2026Q4 ...)
       and rules cannot iterate a map, so the 本季 (this-quarter) board stays
       unbounded; week and total are the two fixed keys. */
    function scoreSane(s) {
      return s.get("alt", 0) <= 2000 && s.get("totalPts", 0) <= 500000
          && s.get("bestStreak", 0) <= 1000
          && s.get("pts", {}).get("week", 0) <= 100000;
    }
    match /scores/{uid} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
                   && scoreSane(request.resource.data.get("g1", {}))
                   && scoreSane(request.resource.data.get("g2", {}))
                   && scoreSane(request.resource.data.get("g3", {}))
                   && scoreSane(request.resource.data.get("hcl", {}));
    }

    // 启航码头 (dock) boards. A SEPARATE collection from scores/{uid} on purpose:
    // the dock's two metrics (航程 distance, 航海值 sailing points) must never
    // merge with the mountain's (海拔 altitude, 历练值 experience), and keeping
    // them in different documents makes an accidental join impossible rather
    // than merely discouraged. Same shape of rule: any signed-in user reads, you write only
    // your own row.
    match /dockScores/{uid} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.data.get("sailed", 0) <= 1000
                   && request.resource.data.get("pts", 0) <= 200000;
    }

    /* ================ class rosters/{org} (owner 2026-09-02) ===============
       Each school's management maintains its own class list, instead of asking
       the owner to edit BV_CLASSES in profile.js every year. The document id IS
       the canonical org string ("百德中学 Bukit View Secondary School").
       Deliberately not a derived key: this side can only string-compare org
       against the document id, and any "normalise first, then compare" scheme
       would need a normalisation function inside the rules language identical
       to the client's, which is not expressible here -- half of one is a gate
       that does not line up.
       Any signed-in user may read, anonymous students included: the sign-up
       page lists classes as soon as the student picks a school, and at that
       point they are still anonymous. A roster holds class codes only, no
       student data. */
    match /rosters/{org} {
      allow read:  if request.auth != null;
      allow write: if isSuper() || (isSchoolManager() && org == myOrg());
    }

    // ===== restore codes claims/{code} (owner 2026-08-19) =================
    // A student who changes device types ONE short code (10 chars) instead of an
    // ~800-character progress string, and gets everything back — mastery,
    // records, and every collectible (灵露 / 贝壳 / 营地 / 海滩).
    // The document IS the restore payload.
    //
    // KEYED BY THE CODE, NOT BY uid, AND THAT IS THE WHOLE SECURITY DESIGN.
    // The obvious alternative — keep the code on users/{uid} and let a new device run
    // users.where("claimCode","==",x) — CANNOT BE SECURED. Firestore rules cannot see a
    // query's where-clause: `allow read` covers get AND list, so permitting that lookup
    // means permitting ANY signed-in user to list every student's full progress
    // document. There is no rule that says "only when filtered by claimCode".
    // Keying by the code turns the lookup into a get() of a document whose ID you must
    // already know, which is exactly the property we want.
    //
    // `list` IS DENIED EXPLICITLY. It is already denied by omission; it is spelled
    // out because granting it later — even by writing a lazy `allow read` — would
    // silently turn the code from a secret into an index and expose every payload.
    // NEVER widen this to `allow read`.
    //
    // Guessing: 10 chars from a 32-symbol alphabet is ~10^15, one network
    // round-trip per attempt, against a few hundred real documents. Brute force is not
    // the threat model; a shoulder-surfed code is, which is why the code is rotatable
    // (delete + re-mint) and why it is never printed on the leaderboard.
    //
    // The owning uid rides INSIDE the document so writes can be checked. create
    // requires you to stamp your own uid; update requires the doc to already be yours,
    // so nobody can squat on or overwrite another student's code.
    match /claims/{code} {
      allow get:    if request.auth != null;
      allow list:   if false;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && code.size() >= 8 && code.size() <= 24;
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
      // rotating a code = delete the old document; only its owner may do that
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    /* Which school a student belongs to, for collections keyed by uid that carry
       no school field of their own (moderation / feedbackQuota). exists() first
       is required: calling get() on a missing document fails evaluation of the
       whole rule, turning "this student has no profile" into a denial. Each
       evaluation costs an extra document read, so use it only on single-student
       paths -- never inside a rule that has to serve a list, such as users/{uid}. */
    function studentSchool(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        ? get(/databases/$(database)/documents/users/$(uid)).data.get("profile", {}).get("school", "")
        : "";
    }

    /* restore log: students append their own rows, never read/edit/delete them.
       read was tightened from isTeacher() to seesAll(): these rows carry no
       school field, so there is nothing to scope them by, and the restore-log
       tab has since been removed -- no UI reads this today. If the scope cannot
       be made correct, do not grant the read. */
    match /restoreLog/{logId} {
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow read:   if seesAll();
      allow update, delete: if false;
    }

    // moderation flags: student reads only its own; only an editor writes, and
    // only for a student in their own school.
    match /moderation/{uid} {
      allow read:  if (request.auth != null && request.auth.uid == uid)
                   || seesAll()
                   || (isSchoolStaff() && studentSchool(uid) == myOrg());
      allow write: if canEdit() && (isSuper() || studentSchool(uid) == myOrg());
    }

    /* ---- teacher sign-up queue teacherRequests/{uid} ---------------------
       Rejection is a STATUS, not a deletion (owner 2026-09-02). Delete the row
       and a rejected applicant can re-apply into what looks to the next
       approver like a clean first submission -- no reason, no count, no
       history. So delete is superadmin-only and the daily path is status.
       The org is written by the APPROVER, not the applicant. Anyone can pick
       "百德中学" on the sign-up page; what counts is the org the approver writes
       onto teachers/{uid}, and an hod can only write their own. */
    match /teacherRequests/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid)
                  || seesAll()
                  || (isSchoolStaff() && rowOrg() == myOrg());

      // applicant: may create only their own row, and only as pending
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.get("status", "pending") == "pending";
      // applicant: may fix typos while UNDECIDED, and it stays pending
      allow update: if request.auth != null && request.auth.uid == uid
                    && resource.data.get("status", "pending") == "pending"
                    && request.resource.data.get("status", "pending") == "pending";

      /* approver: records the decision. Multiple allow blocks are OR-ed, so this
         coexists with the applicant rule above; each covers its own people. */
      allow update: if canEdit()
                    && (isSuper() || (rowOrg() == myOrg() && newRowOrg() == myOrg()))
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(["status", "decidedBy", "decidedAt", "reason", "org", "orgType", "role"])
                    && request.resource.data.status in ["approved", "rejected"];

      allow delete: if isSuper();
    }

    /* ---- teacher list teachers/{uid} (this is where the rights live) -----
       superadmin can only be minted in the console -- it is absent from the
       whitelist below. Same discipline as the 2026-08-14 "hod is minted in the
       console only", one level up: a key that can copy itself through a web page
       is lost permanently the first time it leaks.

       grantable() is the second and only other place where hod and sh differ
       (the first is isSchoolManager(), which lists them together). Owner
       2026-09-04: "HOD/MTL must be granted access by me. HOD can approve SH/CL.
       SH/CL can also be approved by me if need be because some schools' HOD/MTL
       are not CL trained" -- that last clause is the reason: where the Mother
       Tongue head does not teach Chinese, the system admin has to be able to
       appoint an SH/CL directly, over their head.
       This does not contradict "hod and sh have equal rights" (2026-09-03):
       their rights over DATA (student profiles, rosters, feedback, rooms) are
       identical rule for rule. Only what they can GRANT differs, so this
       function is the only place that needs to know. */
    function grantable() {
      return isSuper()        ? ["hod", "sh", "teacher", "viewer"]
           : myRole() == "hod" ? ["sh", "teacher"]
           : myRole() == "sh"  ? ["teacher"]
           : [];
    }
    /* The OLD value must also be one this approver could have granted. Without
       this check, three things go wrong, none of them with an error message:
       (1) an hod can edit another hod at the same school, e.g. demote a peer;
       (2) an sh can edit that school's hod;
       (3) management can edit THEIR OWN row -- demote or deactivate themselves,
           leaving the school with no approver and only the system admin able to
           undo it.
       (3) used to rest on a "you cannot edit yourself" check in the UI; now the
       rules enforce it too, because an hod's own row has role "hod", which is
       not in ["sh","teacher"] (and likewise for sh).
       This also gives an hod the power to DEMOTE: they can appoint an SH/CL, so
       they can withdraw one -- grant-without-revoke would be the stranger
       permission. */
    function rowRoleGrantable() {
      return resource == null || resource.data.get("role", "teacher") in grantable();
    }
    match /teachers/{uid} {
      // own-row read added 2026-08-14: a registered-but-unapproved teacher has no
      // doc here, and gating the read behind isTeacher() made that indistinguishable
      // from being locked out. Reading only your OWN row leaks nothing.
      allow read: if (request.auth != null && request.auth.uid == uid)
                  || seesAll()
                  || (isSchoolStaff() && rowOrg() == myOrg());

      allow create, update:
        if (isSuper() && request.resource.data.role in grantable())
        || (isSchoolManager()
            && request.resource.data.role in grantable()
            && request.resource.data.get("orgType", "school") == "school"
            && newRowOrg() == myOrg()
            && (resource == null || rowOrg() == myOrg())
            && rowRoleGrantable());

      // deactivation is active:false (it leaves a record); only superadmin deletes.
      allow delete: if isSuper();
    }

    // ---- feedback tickets (2026-08-14) --------------------------------------
    // Doc id is deliberately STRUCTURED: "{uid}__{YYYY-MM-DD}__{n}".
    // That is what enforces the daily quota. Firestore rules cannot count
    // documents, so "max N per day" is not expressible the obvious way — but if
    // the id must be one of exactly N permitted names per user per day, and
    // create (unlike set) fails on an existing doc, then N is a HARD
    // server-side ceiling. A student cannot forge someone else's ticket either,
    // because the id must start with their own uid.
    //
    // QUOTA (revised 2026-08-14 after owner feedback): the default is 20/day,
    // not 5. A student who finds 8 real problems in one afternoon is the single
    // most valuable user this feature has, and throttling them to protect
    // against a hypothetical spammer is the wrong trade. feedbackQuota/{uid}
    // overrides the default per student — raise it for a prolific reporter,
    // set it to 0 to shut off an abuser. Absent doc = the default.
    //
    // The day segment is checked against request.time with a ±1 day tolerance:
    // request.time is UTC and the app stamps Asia/Singapore dates (+8), so an
    // early-morning submission legitimately carries "tomorrow" in UTC terms.
    function fbDayOk(day) {
      return day is string && day.size() == 10
        && request.time >= timestamp.date(int(day[0:4]), int(day[5:7]), int(day[8:10])) - duration.value(1, 'd')
        && request.time <  timestamp.date(int(day[0:4]), int(day[5:7]), int(day[8:10])) + duration.value(2, 'd');
    }
    function fbQuota() {
      return exists(/databases/$(database)/documents/feedbackQuota/$(request.auth.uid))
        ? get(/databases/$(database)/documents/feedbackQuota/$(request.auth.uid)).data.max
        : 20;
    }
    match /feedback/{ticketId} {
      /* A student reads only their OWN tickets (so they can follow the status);
         school staff read their own school's queue; global visibility reads all.
         Ticket text is free-form and students do name classmates in it, so it
         has to be scoped by school exactly like users/ -- and it carries a
         school field, stamped at submission time by profile.js.
         Tickets filed before 2026-09-02 have no school field and are readable
         only by superadmin and agency. That is correct: data whose school
         cannot be determined should not be handed out by school. */
      allow read: if seesAll()
                  || (isSchoolStaff() && resource.data.get("school", "") == myOrg())
                  || (request.auth != null && resource.data.uid == request.auth.uid);

      allow create: if request.auth != null
        && ticketId.split("__").size() == 3
        && ticketId.split("__")[0] == request.auth.uid
        && ticketId.split("__")[2].matches("^[0-9]{1,3}$")
        && int(ticketId.split("__")[2]) < fbQuota()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.day == ticketId.split("__")[1]
        && fbDayOk(request.resource.data.day)
        && request.resource.data.status == "new"          // never self-resolve
        && request.resource.data.type in ["content", "bug", "idea", "other"]
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 5
        && request.resource.data.text.size() <= 1000;

      /* Students never edit a submitted ticket (they cannot rewrite history
         after a teacher has replied); staff only move it through the workflow.
         Tightened from isTeacher() to canEdit(): handling a ticket is editing,
         and agency writes nothing. This is the "an absent allow is not a deny"
         case -- isTeacher() let viewers in, because a viewer is also a row in
         teachers/. */
      allow update: if canEdit()
        && (isSuper() || resource.data.get("school", "") == myOrg())
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(["status", "note", "handledBy", "handledAt"])
        && request.resource.data.status in ["new", "open", "resolved", "wontfix"];

      allow delete: if isSuper();
    }

    // per-student daily quota override. Absent = the default in fbQuota().
    // max: 0 is how an abuser is shut off — one control, not a separate ban list.
    // The student may READ their own so the form can show what is left.
    match /feedbackQuota/{uid} {
      allow read:  if (request.auth != null && request.auth.uid == uid)
                   || seesAll()
                   || (isSchoolStaff() && studentSchool(uid) == myOrg());
      allow write: if canEdit() && (isSuper() || studentSchool(uid) == myOrg());
    }

    /* ---------- roomLog: one row per session held (owner 2026-09-05) -------
       Owner: "can the number of sessions for peer challenges and classroom
       challenges be tracked? for proof that the platform is well utilised down
       the line". The rooms collection cannot answer that: it carries a TTL
       (expiresAt, six hours), so its documents are swept away and "how many
       sessions ran last term" simply does not exist in the database. This log
       deliberately carries NO expiresAt and so no TTL policy touches it.

       A row is written the moment a room actually STARTS (status -> running),
       not when it is created: a room that was opened but never started is not a
       session. It is never edited afterwards (see below), so there are no
       half-written rows.
       Both create conditions are needed: stamp your own uid (no impersonation),
       AND the room code must exist and be one you host (nobody can conjure
       sessions and turn the usage evidence into a fiction). That get() costs
       one read per session, and sessions are few.
       Once written the row is immutable; only superadmin can delete. Usage
       evidence that can be edited convinces nobody.
       read is scoped exactly like users/: school staff see their own school
       only, so the client MUST send .where("school","==",myOrg()). Rules are
       evaluated per document, so a missing where means the whole query is
       denied, not a few rows fewer. */
    match /roomLog/{id} {
      allow read: if seesAll() || (isSchoolStaff() && resource.data.school == myOrg());
      allow create: if request.auth != null
                    && request.resource.data.hostUid == request.auth.uid
                    && request.resource.data.kind in ["peer", "class"]
                    && request.resource.data.code is string
                    && request.resource.data.code.size() <= 12
                    && request.resource.data.keys().size() <= 18
                    && exists(/databases/$(database)/documents/rooms/$(request.resource.data.code))
                    && get(/databases/$(database)/documents/rooms/$(request.resource.data.code)).data.hostUid == request.auth.uid;
      allow update: if false;
      allow delete: if isSuper();
    }

    /* 结伴登峰 live classroom rooms. Teachers create and drive them; any
       signed-in (incl. anonymous) user reads the config and writes ONLY their
       own player row. Rooms are ephemeral -- a Firestore TTL policy on
       rooms.expiresAt deletes them.
       Hosting is gated on isSchoolStaff(), not canEdit() and not isStaff():
         - canEdit() would shut ordinary teachers out, and 结伴登峰 is exactly
           their everyday classroom tool -- nothing to do with editing student
           records;
         - isStaff() would let HQ / SCCL open class rooms, and they have no
           classes.
       "May you run a session" asks whether you belong to a school, not whether
       you may edit data. */
    match /rooms/{code} {
      allow read:   if request.auth != null;
      // 结伴登峰 (teacher-hosted) OR 同伴挑战 PK (student-hosted, pk == true).
      // Either way you may only touch a room you yourself host. A student cannot
      // create a teacher-style room because they cannot set pk to anything but true
      // here, and cannot pass isSchoolStaff().
      allow create: if request.auth != null
                    && request.resource.data.hostUid == request.auth.uid
                    && (isSchoolStaff() || request.resource.data.pk == true);
      allow update: if request.auth != null
                    && resource.data.hostUid == request.auth.uid
                    && (isSchoolStaff() || resource.data.pk == true);
      allow delete: if request.auth != null
                    && resource.data.hostUid == request.auth.uid
                    && (isSchoolStaff() || resource.data.pk == true);

      match /players/{uid} {
        allow read: if request.auth != null;
        // create AND update share one condition on purpose: re-joining writes to an
        // EXISTING doc, which Firestore treats as an update. Requiring "running" for
        // update locked out anyone who left and came back during the lobby. Students
        // may (re)join and write their own row any time the room is not ended.
        allow create, update: if request.auth != null && request.auth.uid == uid
                      && get(/databases/$(database)/documents/rooms/$(code)).data.status in ["lobby", "running"];
        // TTL on rooms.expiresAt deletes the ROOM but never its subcollection, so
        // somebody has to clear player rows. Teachers do it via 关闭这场 (end
        // session); a student PK host and each player may now clear their own
        // room's rows too.
        allow delete: if isSchoolStaff()
                      || (request.auth != null && request.auth.uid == uid)
                      || (request.auth != null
                          && get(/databases/$(database)/documents/rooms/$(code)).data.hostUid == request.auth.uid);
      }
    }
  }
}
