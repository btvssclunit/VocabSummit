rules_version = "2";
service cloud.firestore {
  match /databases/{database}/documents {

    function isTeacher() {
      return request.auth != null
        && exists(/databases/$(database)/documents/teachers/$(request.auth.uid))
        && get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.active == true;
    }

    function isHod() {
      return isTeacher()
        && get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.role == "hod";
    }

    // student progress + profile (one doc per anonymous uid)
    match /users/{uid} {
      allow read:  if (request.auth != null && request.auth.uid == uid) || isTeacher();
      allow write: if request.auth != null && request.auth.uid == uid;
      // HOD may correct a wrongly-entered profile (nickname/school/班级/身份) from the
      // teacher dashboard. Scoped to the top-level "profile" field only — an HOD can
      // never touch progress/pts/badges through this path, so mastery data stays
      // student-owned even when fixing a typo'd school or class.
      allow update: if isHod()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["profile", "updatedAt"]);
    }

    // leaderboard scores (one doc per anonymous uid). Any signed-in user reads
    // (needed for the in-app board); each student writes only their own doc.
    match /scores/{uid} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // restore log: students append their own rows, never read/edit/delete them.
    match /restoreLog/{logId} {
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow read:   if isTeacher();
      allow update, delete: if false;
    }

    // moderation flags: student reads only its own, only an HOD writes.
    match /moderation/{uid} {
      allow read:  if (request.auth != null && request.auth.uid == uid) || isTeacher();
      allow write: if isHod();
    }

    // teacher self-registration queue: a signed-in user creates/edits ONLY their
    // own request; teachers/HOD read the queue; an HOD clears handled ones.
    match /teacherRequests/{uid} {
      allow read:          if isTeacher() || (request.auth != null && request.auth.uid == uid);
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete:        if isHod();
    }

    // teacher allowlist (the access gate). Readable by teachers. An HOD may
    // grant/revoke TEACHER access in-app (approvals), but the "hod" role can
    // only ever be minted in the console — request.resource.data.role must be
    // "teacher", so no in-app HOD creation or self-escalation is possible.
    match /teachers/{uid} {
      allow read:  if isTeacher();
      allow write: if isHod() && request.resource.data.role == "teacher";
    }

    // 结伴登峰 live classroom rooms. Teachers create + drive; any signed-in
    // (incl. anonymous) user reads the config and writes ONLY their own player row.
    // Rooms are ephemeral — a Firestore TTL policy on rooms.expiresAt deletes them.
    match /rooms/{code} {
      allow read:   if request.auth != null;
      // 结伴登峰 (teacher-hosted) OR 同伴挑战 PK (student-hosted, pk == true).
      // Either way you may only touch a room you yourself host. A student cannot
      // create a teacher-style room because they cannot set pk to anything but true
      // here, and cannot pass isTeacher().
      allow create: if request.auth != null
                    && request.resource.data.hostUid == request.auth.uid
                    && (isTeacher() || request.resource.data.pk == true);
      allow update: if request.auth != null
                    && resource.data.hostUid == request.auth.uid
                    && (isTeacher() || resource.data.pk == true);
      allow delete: if request.auth != null
                    && resource.data.hostUid == request.auth.uid
                    && (isTeacher() || resource.data.pk == true);

      match /players/{uid} {
        allow read: if request.auth != null;
        // create AND update share one condition on purpose: re-joining writes to an
        // EXISTING doc, which Firestore treats as an update. Requiring "running" for
        // update locked out anyone who left and came back during the lobby. Students
        // may (re)join and write their own row any time the room is not ended.
        allow create, update: if request.auth != null && request.auth.uid == uid
                      && get(/databases/$(database)/documents/rooms/$(code)).data.status in ["lobby", "running"];
        allow delete: if isTeacher();
      }
    }
  }
}
