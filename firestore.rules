rules_version = "2";
service cloud.firestore {
  match /databases/{database}/documents {

    function isTeacher() {
      return request.auth != null
        && exists(/databases/$(database)/documents/teachers/$(request.auth.uid))
        && get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.active == true;
    }

    function isHod() {
      return isTeacher()
        && get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.role == "hod";
    }

    // student progress + profile (one doc per anonymous uid)
    match /users/{uid} {
      allow read:  if (request.auth != null && request.auth.uid == uid) || isTeacher();
      allow write: if request.auth != null && request.auth.uid == uid;
      // HOD may correct a wrongly-entered profile (nickname/school/班级/身份) from the
      // teacher dashboard. Scoped to the top-level "profile" field only — an HOD can
      // never touch progress/pts/badges through this path, so mastery data stays
      // student-owned even when fixing a typo'd school or class.
      allow update: if isHod()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["profile", "updatedAt"]);
    }

    // leaderboard scores (one doc per anonymous uid). Any signed-in user reads
    // (needed for the in-app board); each student writes only their own doc.
    match /scores/{uid} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // restore log: students append their own rows, never read/edit/delete them.
    match /restoreLog/{logId} {
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow read:   if isTeacher();
      allow update, delete: if false;
    }

    // moderation flags: student reads only its own, only an HOD writes.
    match /moderation/{uid} {
      allow read:  if (request.auth != null && request.auth.uid == uid) || isTeacher();
      allow write: if isHod();
    }

    // teacher self-registration queue: a signed-in user creates/edits ONLY their
    // own request; teachers/HOD read the queue; an HOD clears handled ones.
    match /teacherRequests/{uid} {
      allow read:          if isTeacher() || (request.auth != null && request.auth.uid == uid);
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete:        if isHod();
    }

    // teacher allowlist (the access gate). Readable by teachers. An HOD may
    // grant/revoke TEACHER access in-app (approvals), but the "hod" role can
    // only ever be minted in the console — request.resource.data.role must be
    // "teacher", so no in-app HOD creation or self-escalation is possible.
    match /teachers/{uid} {
      // own-row read added 2026-08-14: a registered-but-unapproved teacher has no
      // doc here, and gating the read behind isTeacher() made that indistinguishable
      // from being locked out. Reading only your OWN row leaks nothing.
      allow read:  if isTeacher() || (request.auth != null && request.auth.uid == uid);
      allow write: if isHod() && request.resource.data.role == "teacher";
    }

    // ---- 意见反馈工单 (2026-08-14) ------------------------------------------
    // Doc id is deliberately STRUCTURED: "{uid}__{YYYY-MM-DD}__{n}" with n 0-4.
    // That is what enforces the rate limit. Firestore rules cannot count
    // documents, so a "max 5 per day" check is impossible the obvious way — but
    // if the id must be one of exactly five permitted names per user per day,
    // and create (unlike set) fails on an existing doc, then five is a HARD
    // server-side ceiling that costs zero extra reads. A student cannot forge
    // someone else's ticket either, because the id must start with their uid.
    //
    // The day segment is checked against request.time with a ±1 day tolerance:
    // request.time is UTC and the app stamps Asia/Singapore dates (+8), so an
    // early-morning submission legitimately carries "tomorrow" in UTC terms.
    // The tolerance means a student could straddle midnight for 10 in 24h;
    // that is an accepted trade for not rejecting real submissions at 7am.
    function fbDayOk(day) {
      return day is string && day.size() == 10
        && request.time >= timestamp.date(int(day[0:4]), int(day[5:7]), int(day[8:10])) - duration.value(1, 'd')
        && request.time <  timestamp.date(int(day[0:4]), int(day[5:7]), int(day[8:10])) + duration.value(2, 'd');
    }
    match /feedback/{ticketId} {
      // a student reads only their OWN tickets (so they can see the status);
      // teachers read the whole queue.
      allow read: if isTeacher()
                  || (request.auth != null && resource.data.uid == request.auth.uid);

      allow create: if request.auth != null
        && ticketId.split("__").size() == 3
        && ticketId.split("__")[0] == request.auth.uid
        && ticketId.split("__")[2] in ["0", "1", "2", "3", "4"]
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.day == ticketId.split("__")[1]
        && fbDayOk(request.resource.data.day)
        && request.resource.data.status == "new"          // never self-resolve
        && request.resource.data.type in ["content", "bug", "idea", "other"]
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 5
        && request.resource.data.text.size() <= 1000
        && !exists(/databases/$(database)/documents/feedbackBans/$(request.auth.uid));

      // students never edit a submitted ticket (they cannot rewrite history after
      // a teacher has replied); teachers only ever move it through the workflow.
      allow update: if isTeacher()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(["status", "note", "handledBy", "handledAt"])
        && request.resource.data.status in ["new", "open", "resolved", "wontfix"];

      allow delete: if isHod();
    }

    // feedback ban list: an HOD blocks an abusive submitter. Presence of the doc
    // is the block — the create rule above reads it with exists().
    match /feedbackBans/{uid} {
      allow read:  if isTeacher() || (request.auth != null && request.auth.uid == uid);
      allow write: if isHod();
    }

    // 结伴登峰 live classroom rooms. Teachers create + drive; any signed-in
    // (incl. anonymous) user reads the config and writes ONLY their own player row.
    // Rooms are ephemeral — a Firestore TTL policy on rooms.expiresAt deletes them.
    match /rooms/{code} {
      allow read:   if request.auth != null;
      // 结伴登峰 (teacher-hosted) OR 同伴挑战 PK (student-hosted, pk == true).
      // Either way you may only touch a room you yourself host. A student cannot
      // create a teacher-style room because they cannot set pk to anything but true
      // here, and cannot pass isTeacher().
      allow create: if request.auth != null
                    && request.resource.data.hostUid == request.auth.uid
                    && (isTeacher() || request.resource.data.pk == true);
      allow update: if request.auth != null
                    && resource.data.hostUid == request.auth.uid
                    && (isTeacher() || resource.data.pk == true);
      allow delete: if request.auth != null
                    && resource.data.hostUid == request.auth.uid
                    && (isTeacher() || resource.data.pk == true);

      match /players/{uid} {
        allow read: if request.auth != null;
        // create AND update share one condition on purpose: re-joining writes to an
        // EXISTING doc, which Firestore treats as an update. Requiring "running" for
        // update locked out anyone who left and came back during the lobby. Students
        // may (re)join and write their own row any time the room is not ended.
        allow create, update: if request.auth != null && request.auth.uid == uid
                      && get(/databases/$(database)/documents/rooms/$(code)).data.status in ["lobby", "running"];
        // TTL on rooms.expiresAt deletes the ROOM but never its subcollection, so
        // somebody has to clear player rows. Teachers do it via 关闭这场; a student
        // PK host and each player may now clear their own room's rows too.
        allow delete: if isTeacher()
                      || (request.auth != null && request.auth.uid == uid)
                      || (request.auth != null
                          && get(/databases/$(database)/documents/rooms/$(code)).data.hostUid == request.auth.uid);
      }
    }
  }
}
